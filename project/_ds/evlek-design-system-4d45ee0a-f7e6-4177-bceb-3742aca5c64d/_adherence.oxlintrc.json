{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/patterns/**",
              "ui_kits/carousel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|Hanken Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, Hanken Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cobalt|navy|outline)$/]",
        "message": "<Badge> tone must be one of 'cobalt' | 'navy' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|domain|logoSrc|logoHeight|showPill|key|ref|className|style|children)$/]",
        "message": "<BrandLockup> doesn't accept that prop. Declared props: variant, domain, logoSrc, logoHeight, showPill."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLockup'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<BrandLockup> variant must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|arrow|onDark|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, arrow, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:hairline|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: hairline, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|showLine|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: label, tone, showLine."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cobalt|navy|light)$/]",
        "message": "<Eyebrow> tone must be one of 'cobalt' | 'navy' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloorPlan'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|furniture|stroke|detail|key|ref|className|style|children)$/]",
        "message": "<FloorPlan> doesn't accept that prop. Declared props: width, furniture, stroke, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|tone|key|ref|className|style|children)$/]",
        "message": "<PageNumber> doesn't accept that prop. Declared props: current, total, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageNumber'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|cobalt|light)$/]",
        "message": "<PageNumber> tone must be one of 'navy' | 'cobalt' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wave'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|layered|color|under|key|ref|className|style|children)$/]",
        "message": "<Wave> doesn't accept that prop. Declared props: height, layered, color, under."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
