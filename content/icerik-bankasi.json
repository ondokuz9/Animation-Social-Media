{
  "name": "Evlek içerik bankası — dört sütun",
  "why": "Haftalık üretimin darboğazı render değil, KONU. Bu banka konuyu bitmez kılar: her sütun bir izleyici sorusunu yanıtlar ve kendi yakıtı vardır (6 şehir, 15+ semt, 12 süreç sorusu, sınırsız ilan).",
  "pillars": {
    "PAZAR": "Ne oluyor? — canlı veri, otomatik, her hafta yeniden üretilebilir.",
    "YER": "Nerede yaşarım? — 15+ semt, 6 şehir; kalıcı kütüphane.",
    "YOL": "Nasıl yaparım? — ürün ve süreç gerçeği; en yüksek dönüşüm.",
    "KANIT": "Gerçek mi? — gerçek ilan, gerçek emlakçı; güvenin kanıtı."
  },
  "rotation": "Hafta 1 PAZAR · Hafta 2 YOL · Hafta 3 YER · Hafta 4 KANIT → başa dön. Aynı sütun art arda iki hafta gelmez; aynı dünya (renk) art arda iki hafta kullanılmaz.",
  "rules": [
    "Konu bankadan seçilir, icat edilmez.",
    "'needs' alanı dolu bir konu, o girdi gelmeden çekime alınmaz.",
    "Veri kaynağı olmayan iddia videoya girmez.",
    "Her video kaynak satırı + tarih taşır."
  ],
